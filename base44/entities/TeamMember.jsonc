{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Member name"
    },
    "role": {
      "type": "string",
      "description": "Member role"
    },
    "department": {
      "type": "string",
      "description": "Department"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "avatar": {
      "type": "string",
      "description": "Avatar image URL"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the member is active"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name",
    "role"
  ]
}